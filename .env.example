# Copia este archivo a .env y completa los valores.

# --- Producción (docker-compose.yml) ---
# Contraseña de Postgres. Usa solo letras y números: va dentro de una URL.
# Generar: openssl rand -hex 24
POSTGRES_PASSWORD=
# Secreto de sesiones, mínimo 32 caracteres. Generar: openssl rand -hex 32
BETTER_AUTH_SECRET=
# URL pública, la misma del server_name de Nginx.
APP_URL=https://spy.tudominio.com
# Puerto local donde escucha la API (Nginx hace proxy hacia aquí).
API_PORT=3020

# --- Desarrollo local (pnpm dev) ---
# DATABASE_URL=postgres://icmspy:icmspy@localhost:5433/icmspy
# BETTER_AUTH_SECRET=dev-secret-dev-secret-dev-secret-1234
# APP_URL=http://localhost:5173
